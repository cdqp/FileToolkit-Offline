{
  "name": "cdqp-offline-file-toolkit",
  "version": "2.0.0",
  "private": true,
  "description": "Boîte à outils de fichiers 100 % locale, livrée sous forme d'un unique fichier HTML hors ligne.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/build.mjs --check",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "format": "prettier --write \"src/**/*.{js,css,html}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\"",
    "lint:format": "prettier --check \"src/**/*.{js,css,html}\" \"scripts/**/*.mjs\" \"tests/**/*.mjs\""
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "acorn": "8.18.0",
    "esbuild": "0.28.2",
    "jszip": "3.10.1",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "prettier": "3.9.9"
  },
  "engines": {
    "node": ">=22.13"
  }
}
